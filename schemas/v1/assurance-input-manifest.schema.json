{
  "$id": "https://quantum-l9.dev/l9-harness/schemas/v1/assurance-input-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assuranceInputDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "completeForRequestedPlan": {
      "type": "boolean"
    },
    "inputSetId": {
      "$ref": "common.schema.json#/$defs/contentId"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observationIndexRef": {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    "observations": {
      "items": {
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "profileRef": {
      "type": "object"
    },
    "registryDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "schema": {
      "const": "l9.assurance-input-manifest"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "git-revision"
        },
        "repository": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          },
          "required": [
            "host",
            "owner",
            "name"
          ],
          "type": "object"
        },
        "revision": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            "treeDigest": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "commit"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "repository",
        "revision"
      ],
      "type": "object"
    },
    "subjectIdentityDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "supportingArtifacts": {
      "items": {
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "inputSetId",
    "subject",
    "subjectIdentityDigest",
    "profileRef",
    "registryDigest",
    "observationIndexRef",
    "observations",
    "supportingArtifacts",
    "assuranceInputDigest",
    "completeForRequestedPlan",
    "limitations"
  ],
  "title": "assurance-input-manifest",
  "type": "object"
}

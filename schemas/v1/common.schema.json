{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "minimum": 0,
          "type": "integer"
        },
        "canonicalPayloadDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "byteLength",
        "rawDigest"
      ],
      "type": "object"
    },
    "contentId": {
      "pattern": "^[a-z0-9.-]+:sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "extensions": {
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]+$"
      },
      "type": "object"
    },
    "relativePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$",
      "type": "string"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$id": "https://quantum-l9.dev/l9-harness/schemas/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L9 Harness Common Types"
}
